# Only needed once you wire src/api.js into App.jsx for live data.
# Copy to .env.local for local dev. For GitHub Pages, these get baked in at
# build time via the GitHub Actions workflow (see repo secrets in the README).

VITE_API_BASE=https://your-backend.onrender.com
VITE_API_TOKEN=same-value-as-API_AUTH_TOKEN-on-the-backend
