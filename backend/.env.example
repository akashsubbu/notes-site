# Copy this file to .env for local dev, and set the same keys as
# environment variables in your Render/Railway dashboard for deployment.
# Nothing in this file is note content — it's only credentials the server
# needs to reach Notion, GitHub, and Google on your behalf.

# --- Auth (protects write endpoints on your deployed backend) ---
# Any long random string. Your frontend must send this as:
#   Authorization: Bearer <API_AUTH_TOKEN>
# on any request that changes data (mastery, quick notes, post-mortem entries).
API_AUTH_TOKEN=change-me-to-a-long-random-string

# --- Notion (course/topic tracking metadata only — no note content) ---
# Create an internal integration at https://www.notion.so/my-integrations,
# then share your parent Notion page (or at least the Courses database and
# every course page) with it. Only the Courses database ID is needed —
# each course's own topics table is discovered automatically by scanning
# that course page for an embedded database titled "topics" (see
# getTopicsDatabaseIdForCourse in src/integrations/notion.js). There is no
# NOTION_TOPICS_DB_ID: this setup doesn't use one shared Topics database.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_COURSES_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub (this IS your Obsidian vault — the actual note content lives here) ---
# Create a fine-grained Personal Access Token with Contents: Read & write,
# scoped to just this one repo, at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-obsidian-vault-repo-name
GITHUB_BRANCH=main
# Path inside the repo to the root of the vault, if it's not the repo root.
GITHUB_VAULT_ROOT=COMPUTING

# --- Google Calendar ---
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# (application type: Web application). Add GOOGLE_REDIRECT_URI as an
# authorized redirect URI in that same console.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/auth/google/callback
# Filled in automatically the first time you complete the OAuth flow at
# /auth/google — see README for why this one credential is the exception
# to "no storage elsewhere."
GOOGLE_REFRESH_TOKEN=

# --- Server ---
PORT=3000
# Comma-separated list of origins allowed to call this API (your frontend's URL(s)).
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
